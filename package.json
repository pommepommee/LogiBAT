{
    "name": "LogiBAT",
    "description": "Logitech Battery Tray Widget",
    "main": "./index.js",
    "bin": "./index.js",
    "version": "0.0.1",
    "engines": {
        "node": ">=20"
    },
    "prettier": {
        "trailingComma": "all",
        "tabWidth": 3,
        "semi": true,
        "singleQuote": true,
        "bracketSpacing": true,
        "printWidth": 170
    },
    "dependencies": {
        "not-the-systray": "^0.3.1",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@yao-pkg/pkg": "^6.22.0",
        "create-nodew-exe": "^2.1.1"
    },
    "pkg": {
        "assets": [
            "./ico/*",
            "./node_modules/not-the-systray/notify_icon.node"
        ],
        "targets": [
            "node22-win-x64"
        ],
        "outputPath": "./bin"
    },
    "scripts": {
        "build": "pkg .",
        "postbuild": "create-nodew-exe ./bin/LogiBAT.exe ./bin/LogiBAT.exe"
    }
}
